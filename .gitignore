# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Test / tooling
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Local run artifacts
runs/
results/
